# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=changeme-generate-your-own
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth. Leave empty to hide the "Continue with Google" button.
# Authorized redirect URIs to register in Google Cloud Console:
#   http://localhost:8000/accounts/google/login/callback/
#   https://<your-username>.pythonanywhere.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM provider (OpenAI-style chat completions). Leave the key empty to use the rule-based fallback.
AI_API_KEY=
AI_API_MODEL=gemini-3.1-flash-lite
AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Deal Radar: set to False to stop the radar page looking up nearby shops on OpenStreetMap.
RADAR_OSM_ENABLED=True
