# Copy to .env and fill in real values. Never commit .env.

SECRET_KEY=changeme-generate-your-own
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth. Leave empty to hide the "Continue with Google" button.
# Authorized redirect URIs to register in Google Cloud Console:
#   http://localhost:8000/accounts/google/login/callback/
#   https://<your-username>.pythonanywhere.com/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM provider key (variable name to be finalized once the provider is chosen)
LLM_API_KEY=
